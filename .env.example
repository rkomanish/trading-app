# Copy to .env and fill in real values. NEVER commit .env.
# Demo/app login (set strong values for any public deployment!)
APP_USERNAME=admin
APP_PASSWORD=change-me-to-something-strong

# Database (docker-compose uses these for the bundled Postgres)
DB_USERNAME=postgres
DB_PASSWORD=change-me-too

# For a managed/external Postgres instead, set the full JDBC URL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DBNAME

# Daily auto-import of NIFTY candles from Yahoo (weekdays 16:00 IST).
# Lets your 1m history grow over time. Set false to disable.
DATA_IMPORT_ENABLED=true

# Claude (used by sentiment veto + strategy enhancement). Optional.
ANTHROPIC_API_KEY=not-set

# Zerodha Kite (optional — live/historical data). Live trading stays OFF by config.
KITE_API_KEY=not-set
KITE_API_SECRET=not-set
KITE_REDIRECT_URL=https://YOUR_DOMAIN/auth/kite/callback

# Dhan free market data (optional)
DHAN_ENABLED=false
DHAN_CLIENT_ID=not-set
DHAN_ACCESS_TOKEN=not-set
